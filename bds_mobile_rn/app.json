{
  "expo": {
    "name": "BDS Smart Branch",
    "slug": "bds-mobile-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#E8EAF6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bds.smartbranch",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow this app to access your location to find the nearest bank branch."
      }
    },
    "android": {
      "package": "com.bds.smartbranch",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow this app to access your location to find the nearest bank branch."
        }
      ]
    ]
  }
}
